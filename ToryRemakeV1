local function grabLine(m, cat)
    local bag = roastLines[m] or roastLines.VOID
    local list = bag[cat]
    if not list or #list == 0 then return "bro something happened 💀" end
    return list[math.random(1, #list)]
end

local function fireCmd(...)
    return ReplicatedStorage:WaitForChild("01_server"):FireServer(...)
end

local function forceReset() fireCmd("cmd", "-re") end
local function stripHats() fireCmd("cmd", "-ch") end
local function swapR6() fireCmd("cmd", "-r6") end
local function swapR15() fireCmd("cmd", "-r15") end

local function findPlayer(name)
    if not name or name == "" then return end
    name = name:lower():gsub("([%.%+%-%*%?%[%]%^%$%(%)%%])", "%%%1")
    for _, a in Players:GetPlayers() do
        if a ~= vibe then
            local char = a.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local n, d = a.Name:lower(), a.DisplayName:lower()
                    if n:find("^" .. name) or d:find("^" .. name) then
                        return a
                    end
                end
            end
        end
    end
end

local function runMain(targetName)
    local target = findPlayer(targetName)
    if not target then return false end
    local targetchar = target.Character
    if not targetchar then return false end
    local targethrp = targetchar:FindFirstChild("HumanoidRootPart") or targetchar:WaitForChild("HumanoidRootPart", 5)
    if not targethrp then return false end
    local char = vibe.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local backpack = vibe:FindFirstChild("Backpack")
    if not backpack then return false end
    local tool = chosenGear and (char:FindFirstChild(chosenGear) or backpack:FindFirstChild(chosenGear)) or (char:FindFirstChildOfClass("Tool") or backpack:FindFirstChildOfClass("Tool"))
    if not tool then return "NO TOOL" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.RigType ~= Enum.HumanoidRigType.R6 then
        swapR6()
        r6Swapped = true
        task.wait(0.35)
        char = vibe.Character
        if not char then return false end
        hrp = char:FindFirstChild("HumanoidRootPart")
        backpack = vibe:FindFirstChild("Backpack")
        if not backpack then return false end
        tool = chosenGear and (char:FindFirstChild(chosenGear) or backpack:FindFirstChild(chosenGear)) or (char:FindFirstChildOfClass("Tool") or backpack:FindFirstChildOfClass("Tool"))
        if not tool then return "NO TOOL" end
    end
    task.wait(0.2)
    stripHats()
    local savedDeathY = workspace.FallenPartsDestroyHeight
    if mode == "GIVE" then
        if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid"):Destroy() end
        task.wait(0.05)
        Instance.new("Humanoid").Parent = char
        tool.Parent = char
        local handle = tool:FindFirstChild("Handle")
        local giveStart = os.clock()
        while tool.Parent == char and (os.clock() - giveStart) < 3 do
            task.wait()
            pcall(function()
                if hrp then hrp.CFrame = targethrp.CFrame end
                if handle then handle.CFrame = targethrp.CFrame end
            end)
        end
        workspace.FallenPartsDestroyHeight = savedDeathY
        vibe.Character = nil
        fireCmd("cmd", "-rs")
        forceReset()
        return true
    end
    char.Archivable = true
    local copy = char:Clone()
    task.wait(0.05)
    vibe.Character = copy
    task.wait(0.1)
    vibe.Character = char
    task.wait(0.1)
    if copy and copy.Parent then copy:Destroy() end
    if hrp then hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
    if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid"):Destroy() end
    task.wait(0.05)
    Instance.new("Humanoid").Parent = char
    task.wait(0.05)
    tool.Grip = CFrame.new(0, 0, 0)
    tool.Parent = char
    local handle = tool:FindFirstChild("Handle")
    local noclip = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
    local touched = false
    local touchTime = 0
    local startTime = os.clock()
    repeat
        RunService.Stepped:Wait()
        if not tool or not tool:IsDescendantOf(game) then break end
        if tool.Parent ~= char and tool.Parent ~= targetchar and tool.Parent ~= workspace then break end
        if not touched and (os.clock() - startTime > 5.0) then break end
        if targetchar and targethrp and hrp then
            if tool.Parent == targetchar and not touched then
                touched = true
                touchTime = os.clock()
                if mode == "BRING" then
                    task.wait(0.15)
                    break
                else
                    task.wait(0.02)
                end
            end
            if touched then
                if mode == "VOID" then
                    workspace.FallenPartsDestroyHeight = lowDeathY
                    local vcf = CFrame.new(hrp.Position.X, (originalDeathY or savedDeathY or -500) - 25, hrp.Position.Z)
                    hrp.CFrame = vcf
                    pcall(function()
                        targethrp.CFrame = vcf
                        targethrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end)
                    if os.clock() - touchTime > 1.5 then break end
                elseif mode == "EXTREME" then
                    workspace.FallenPartsDestroyHeight = lowDeathY
                    hrp.CFrame = maxCoords
                    pcall(function()
                        targethrp.CFrame = maxCoords
                        targethrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end)
                    if os.clock() - touchTime > 2.0 then break end
                elseif mode == "BRING" then
                    if homePos then
                        hrp.CFrame = homePos
                        pcall(function()
                            targethrp.CFrame = homePos
                            targethrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end)
                    end
                    if os.clock() - touchTime > 1.8 then break end
                end
            else
                if mode == "EXTREME" then
                    pcall(function() hrp.CFrame = targethrp.CFrame end)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                elseif mode == "VOID" then
                    workspace.FallenPartsDestroyHeight = lowDeathY
                    if homePos then
                        local preV = CFrame.new(homePos.Position.X, (originalDeathY or savedDeathY or -500) - 25, homePos.Position.Z)
                        hrp.CFrame = preV
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                    pcall(function()
                        if handle then
                            targethrp.CFrame = handle.CFrame
                            targethrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    end)
                else
                    pcall(function()
                        if handle then
                            targethrp.CFrame = handle.CFrame
                            targethrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    end)
                    if homePos then
                        hrp.CFrame = homePos
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        else
            break
        end
    until tool.Parent == workspace
    workspace.FallenPartsDestroyHeight = savedDeathY
    if noclip then noclip:Disconnect() end
    if mode == "BRING" then
        if hrp and homePos then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            hrp.CFrame = homePos
            pcall(function()
                targethrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                targethrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                targethrp.CFrame = homePos
            end)
            task.wait(0.4)
        end
    else
        if hrp and homePos then
            hrp.CFrame = homePos
            RunService.Heartbeat:Wait()
        end
    end
    vibe.Character = nil
    return true
end

local function awaitSpawn(timeout)
    local deadline = os.clock() + (timeout or 5)
    local fired = false
    local conn = vibe.CharacterAdded:Connect(function() fired = true end)
    while os.clock() < deadline and not fired do task.wait(0.05) end
    conn:Disconnect()
    return fired
end

local function snapHome()
    if not canSnap or not homePos then return end
    local target = homePos
    local newChar = vibe.Character
    local deadline = os.clock() + 3
    while not newChar and os.clock() < deadline do
        task.wait(0.05)
        newChar = vibe.Character
    end
    if not newChar then return end
    task.wait(0.15)
    for _ = 1, 4 do
        local hrp = newChar:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = target
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        task.wait(0.15)
    end
end

local function executeFlow(targetName)
    if busy then return end
    local char = vibe.Character
    if not char or not char:FindFirstChildOfClass("Humanoid") then return "NO CHAR" end
    busy = true
    local hrp = char:FindFirstChild("HumanoidRootPart")
    homePos = hrp and hrp.CFrame or nil
    canSnap = true
    local status = runMain(targetName)
    if not status or status == "NO TOOL" then
        busy = false
        homePos = nil
        canSnap = false
        return (status == "NO TOOL") and "NO TOOL" or "NOT FOUND"
    end
    for _ = 1, 3 do
        vibe.Character = nil
        forceReset()
        if awaitSpawn(1.2) then break end
    end
    snapHome()
    if r6Swapped then
        r6Swapped = false
        swapR15()
    end
    homePos = nil
    canSnap = false
    busy = false
    task.wait(0.15)
    return "SUCCESS"
end

local function grad(inst, c1, c2, rot)
    local g = Instance.new("UIGradient", inst)
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2)
    })
    g.Rotation = rot or 90
    return g
end

local function hoverFx(btn)
    local base = btn.BackgroundColor3
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = base:Lerp(Color3.fromRGB(255, 255, 255), 0.22)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = base
        }):Play()
    end)
end

