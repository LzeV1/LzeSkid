local ownGear = {}
local function refreshOwnGear()
    ownGear = {}
    local backpack = vibe:FindFirstChild("Backpack")
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if v:IsA("Tool") then ownGear[v] = true end
        end
    end
    local char = vibe.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then ownGear[v] = true end
        end
    end
end

local function inMyTool(part, char)
    local p = part.Parent
    while p and p ~= char do
        if p:IsA("Tool") then return true end
        p = p.Parent
    end
    return false
end

local shieldCooldown = 0
local function pingShield()
    local now = tick()
    if now - shieldCooldown < flashTimer then return end
    shieldCooldown = now
    pushNotif(grabLine(mode, "shielded"), mode)
end

local function denyTouch(char)
    if not char then return end
    local function kill(part)
        if part:IsA("BasePart") and not inMyTool(part, char) then
            part.CanTouch = false
            local ti = part:FindFirstChildOfClass("TouchTransmitter")
            if ti then ti:Destroy() end
        end
    end
    for _, d in ipairs(char:GetDescendants()) do kill(d) end
    char.DescendantAdded:Connect(function(d) kill(d) end)
    task.spawn(function()
        while char.Parent do
            for _, d in ipairs(char:GetDescendants()) do kill(d) end
            task.wait(0.2)
        end
    end)
end

local function guardTools(char)
    if not char then return end
    char.ChildAdded:Connect(function(obj)
        if obj:IsA("Tool") and not ownGear[obj] then
            pcall(function() obj:Destroy() end)
            screenFlash(Color3.fromRGB(255, 200, 100), 0.2)
            pingShield()
        end
    end)
end

local function guardMovement(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local anchor = hrp.CFrame
    local lastCheck = tick()
    local snapping = false

    local function scan(current)
        if snapping then return end
        if busy or not hrp.Parent or not char.Parent then
            anchor = current
            lastCheck = tick()
            return
        end
        local now = tick()
        local dt = math.max(now - lastCheck, 1/60)
        lastCheck = now
        local delta = (current.Position - anchor.Position).Magnitude
        local vel = hrp.AssemblyLinearVelocity
        local allowed = vel.Magnitude * dt * velFactor + softTp
        local isTp = delta > allowed
        local isHard = delta > hardTp
        local isFling = vel.Magnitude > 200 and (math.abs(vel.X) > 80 or math.abs(vel.Z) > 80 or vel.Y > 80)
        if isTp or isFling then
            snapping = true
            hrp.CFrame = anchor
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            snapping = false
            screenFlash(Color3.fromRGB(255, 80, 80), 0.3)
            pingShield()
            if isHard then
                panicReset()
            end
        else
            anchor = current
        end
    end

    local function ticker()
        if hrp.Parent then scan(hrp.CFrame) end
    end

    RunService.Heartbeat:Connect(ticker)
    RunService.Stepped:Connect(ticker)
    RunService.RenderStepped:Connect(ticker)
    pcall(function() RunService.PreSimulation:Connect(ticker) end)
    pcall(function() RunService.PostSimulation:Connect(ticker) end)

    hrp:GetPropertyChangedSignal("CFrame"):Connect(function()
        if hrp.Parent then scan(hrp.CFrame) end
    end)
end

local function guardVoid(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local anchor = hrp.CFrame
    local function scan()
        if busy or not hrp.Parent or not char.Parent then
            if hrp.Parent then anchor = hrp.CFrame end
            return
        end
        local pos = hrp.Position
        local fy = workspace.FallenPartsDestroyHeight or -500
        local bad = (pos.Y ~= pos.Y) or (pos.X ~= pos.X) or (pos.Z ~= pos.Z)
        local isVoid = pos.Y < (fy + 30) or pos.Y < -100 or pos.Y > 50000
        if bad or isVoid then
            hrp.CFrame = anchor
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            screenFlash(Color3.fromRGB(255, 80, 80), 0.3)
            pingShield()
            panicReset()
        else
            anchor = hrp.CFrame
        end
    end
    RunService.Heartbeat:Connect(scan)
    RunService.Stepped:Connect(scan)
    RunService.RenderStepped:Connect(scan)
end

local function cleanMovers(char)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BodyPosition") or d:IsA("BodyGyro")
            or d:IsA("BodyVelocity") or d:IsA("BodyAngularVelocity")
            or d:IsA("BodyForce") or d:IsA("BodyThrust")
            or d:IsA("AlignPosition") or d:IsA("AlignOrientation")
            or d:IsA("LinearVelocity") or d:IsA("AngularVelocity")
            or d:IsA("VectorForce") or d:IsA("Torque") then
            pcall(function() d:Destroy() end)
        end
    end
end

local function guardFling(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    RunService.Stepped:Connect(function()
        if busy or not hrp.Parent then return end
        local vel = hrp.AssemblyLinearVelocity
        if vel.Magnitude > 150 then
            hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.05, math.min(vel.Y, 50), vel.Z * 0.05)
        end
        if hrp.AssemblyAngularVelocity.Magnitude > 25 then
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function guardAnchor(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp:GetPropertyChangedSignal("Anchored"):Connect(function()
        if hrp.Anchored and not busy then
            hrp.Anchored = false
        end
    end)
end

local function guardVelocity(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp:GetPropertyChangedSignal("AssemblyLinearVelocity"):Connect(function()
        if busy then return end
        local v = hrp.AssemblyLinearVelocity
        if v.Magnitude > 500 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            pingShield()
        end
    end)
end

local function watchChar(char)
    if not char then return end
    refreshOwnGear()
    denyTouch(char)
    guardTools(char)
    guardMovement(char)
    guardVoid(char)
    cleanMovers(char)
    guardFling(char)
    guardAnchor(char)
    guardVelocity(char)

    task.spawn(function()
        while char.Parent do
            cleanMovers(char)
            task.wait(0.2)
        end
    end)
end

