local function goRun(targetName)
    if busy then return end
    if not chosenGear then
        setBtnText("no tool", 1.4)
        pushNotif("bro you aint pick a tool yet 💀 go click the + button and pick one fr, you really thought you could cook with imagination?? 💀🍳 LMAOOO", mode)
        screenFlash(Color3.fromRGB(255, 200, 100), 0.25)
        return
    end
    local char = vibe.Character
    if char then
        local hasChar = char:FindFirstChild(chosenGear)
        local hasBag = vibe:FindFirstChild("Backpack") and vibe.Backpack:FindFirstChild(chosenGear)
        if not hasChar and not hasBag then
            setBtnText("tool gone", 1.4)
            pushNotif("bro that tool '" .. chosenGear .. "' aint in your inventory anymore 💀 did it vanish into thin air or what?? pick a new one fr 💀🗑️", mode)
            screenFlash(Color3.fromRGB(255, 200, 100), 0.25)
            chosenGear = nil
            rebuildGearList()
            return
        end
    end
    local runMode = mode
    setBtnText("cookin")
    pushNotif(grabLine(runMode, "working"), runMode)
    local res = executeFlow(targetName)
    if res == "NOT FOUND" then
        setBtnText("where?", 1.2)
        pushNotif(grabLine(runMode, "notfound"), runMode)
    elseif res == "NO TOOL" then
        setBtnText("no tool", 1.2)
        pushNotif(grabLine(runMode, "notool"), runMode)
    elseif res == "NO CHAR" then
        setBtnText("no char", 1.2)
        pushNotif(grabLine(runMode, "nochar"), runMode)
    else
        setBtnText("done", 0.6)
        pushNotif(grabLine(runMode, "success"), runMode)
    end
    rebuildGearList()
end

